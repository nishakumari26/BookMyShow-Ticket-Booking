# Copy to .env and fill in real values. Never commit .env.

SPRING_PROFILES_ACTIVE=dev

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookmyshow
DB_USERNAME=root
DB_PASSWORD=

# JWT — generate a long random string (32+ characters) for production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=86400000
JWT_EXPIRATION_MS=86400000

# SMTP
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Frontend origin used for CORS (no wildcard in production)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional production admin bootstrap (Railway env vars, not source)
APP_SEED_DATA=false
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Docker Compose host ports (avoid clashing with a local MySQL on 3306)
MYSQL_PUBLISH_PORT=3307
BACKEND_PUBLISH_PORT=18080
FRONTEND_PUBLISH_PORT=13000
MYSQL_ROOT_PASSWORD=change-me-local-only
MYSQL_PASSWORD=change-me-local-only
